RESEARCHOS_DATA_DIR=./data
# Default local endpoint: Ollama. To use LM Studio, set the base URL to http://127.0.0.1:1234/v1 and key to lm-studio.
RESEARCHOS_MODEL_BASE_URL=http://127.0.0.1:11434/v1
RESEARCHOS_MODEL_API_KEY=ollama
RESEARCHOS_MODEL_NAME=qwen2.5:7b
RESEARCHOS_REQUEST_TIMEOUT_SECONDS=120
RESEARCHOS_PAPER_ANALYSIS_TIMEOUT_SECONDS=600
RESEARCHOS_MAX_SEARCH_RESULTS_PER_SOURCE=20
RESEARCHOS_MAX_PAPERS_PER_RUN=48
RESEARCHOS_MAX_ANALYSIS_PAPERS=12
